<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.CampusSilencer" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Adaptive window background and status bar -->
        <item name="android:windowBackground">@color/bg_space</item>
        <item name="android:statusBarColor">@color/bg_space</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">?attr/isLightTheme</item>
        
        <!-- Primary & Accent tokens -->
        <item name="colorPrimary">@color/amber_500</item>
        <item name="colorAccent">@color/amber_400</item>
        <item name="android:textColorPrimary">@color/text_white</item>
        <item name="android:textColorSecondary">@color/text_slate_400</item>
    </style>
</resources>
